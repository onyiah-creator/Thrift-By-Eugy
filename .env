# Public Worker URL — no secret, committed so a fresh clone renders photos.
#
# Only IMAGE_BASE belongs here. It is used in <img src>, which needs no CORS,
# so an absolute URL is safe in every environment.
#
# VITE_API_URL and VITE_IMAGE_API are deliberately NOT set: both are called
# with fetch(), and both Workers restrict Access-Control-Allow-Origin to the
# deployed Pages URL. Setting them absolute here would make localhost fail
# CORS. Left unset, they route through the dev-server proxy in development and
# fall back to the live Workers in a production build.
#
# Cloudflare Pages does not read this file — set VITE_IMAGE_BASE in the Pages
# dashboard as a build-time variable and redeploy.
VITE_IMAGE_BASE=https://thriftbyeugy-images.onyiah.workers.dev
